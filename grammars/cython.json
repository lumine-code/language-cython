    "parserSource": "github:b0o/tree-sitter-cython#756a20c4d601b715f7b321eaad144f4cb14031bf",
    "wasmBuildTool": "tree-sitter-cli#v0.27.0",
    "grammar": "cython.wasm",
    "highlightsQuery": "cython-highlights.scm",
    "foldsQuery": "cython-folds.scm",
    "indentsQuery": "cython-indents.scm",
    "tagsQuery": "cython-tags.scm",
    "localsQuery": "cython-locals.scm"
  }
